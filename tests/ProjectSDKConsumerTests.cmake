cmake_minimum_required(VERSION 3.21)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${errors}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyEngineSDKQA-${suffix}" qa)
set(sdk_original "${qa}/sdk-original")
set(sdk "${qa}/SDK 中文 with spaces")
set(consumer "${qa}/Consumer")
file(MAKE_DIRECTORY "${consumer}")
foreach(config Debug Release)
    run("${CMAKE_COMMAND}" --build "${ENGINE_BUILD}" --config "${config}" --target tinyengine_project_sdk --parallel 4)
    run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${config}" --component ProjectSDK --prefix "${sdk_original}")
endforeach()
file(RENAME "${sdk_original}" "${sdk}")
file(COPY "${ENGINE_SOURCE}/tests/ProjectSDKConsumer/" DESTINATION "${consumer}")
file(WRITE "${consumer}/Game.tinyproject" "project.name=RotateGame\nproject.id=sdk-consumer\ncode.module=game.rotate\ncode.required=true\ncode.manifest=Binaries/Windows-x64/Project.modules\nproject.startupScene=Start.scene\n")
run("${CMAKE_COMMAND}" -S "${consumer}" -B "${consumer}/build" -G "${GENERATOR}" -A x64
    "-DCMAKE_PREFIX_PATH=${sdk}" "-DEXPECTED_SDK_PREFIX=${sdk}")
foreach(config Debug Release)
    run("${CMAKE_COMMAND}" --build "${consumer}/build" --config "${config}" --parallel 4)
endforeach()
set(manifest "${consumer}/Binaries/Windows-x64/Project.modules")
file(READ "${manifest}" before)
string(REGEX MATCH "Development.library=([^\n]+)" match "${before}")
set(previous_library "${consumer}/${CMAKE_MATCH_1}")
file(SHA256 "${previous_library}" old_hash)
if(NOT before MATCHES "Development.sdkBuildId=[a-f0-9]+" OR NOT before MATCHES "Shipping.sdkBuildId=[a-f0-9]+")
    message(FATAL_ERROR "Manifest must preserve both configuration identities: ${before}")
endif()
file(READ "${consumer}/Source/Game.cpp" source)
file(APPEND "${consumer}/Source/Game.cpp" "\n#error deliberate_compile_failure\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug RESULT_VARIABLE broken OUTPUT_QUIET ERROR_QUIET)
if(broken EQUAL 0)
    message(FATAL_ERROR "Deliberately broken project unexpectedly compiled")
endif()
file(READ "${manifest}" after_failure)
file(SHA256 "${previous_library}" after_hash)
if(NOT before STREQUAL after_failure OR NOT old_hash STREQUAL after_hash)
    message(FATAL_ERROR "Failed build replaced the last working manifest or binary")
endif()
file(WRITE "${consumer}/Source/Game.cpp" "${source}\n// second valid revision\n")
run("${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug --parallel 4)
file(READ "${manifest}" after_success)
if(before STREQUAL after_success)
    message(FATAL_ERROR "Source content change did not produce a new BuildId")
endif()
string(REGEX MATCH "Shipping.buildId=([^\n]+)" shipping "${before}")
if(NOT after_success MATCHES "${shipping}")
    message(FATAL_ERROR "Debug publishing lost the Shipping record")
endif()
run("${MODULE_TEST_EXE}" --inspect-project "${consumer}/Game.tinyproject" Development)
file(WRITE "${QA_POINTER}" "${qa}")
message(STATUS "PASS relocated SDK Debug/Release, failed-build preservation and actual project execution: ${qa}")
