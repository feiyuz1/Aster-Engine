cmake_minimum_required(VERSION 3.21)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${errors}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyEngineCreate-${suffix}" qa)
set(sdk "${qa}/SDK 中文 with spaces")
set(projects "${qa}/Projects 中文 with spaces")
run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${CONFIG}" --component ProjectSDK --prefix "${sdk}")
run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${CONFIG}" --component EditorRuntime --prefix "${sdk}")
run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${CONFIG}" --component ProjectRuntime --prefix "${sdk}")
run("${CREATE_EXE}" "${sdk}" "${projects}")
run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${CONFIG}" --component ProjectTool --prefix "${sdk}")
run("${sdk}/Programs/ProjectTool/TinyEngineProjectTool.exe" --generate-project "${projects}/FirstGame/FirstGame.tinyproject" --quiet)
run("${CMAKE_COMMAND}" "-DSOLUTION_FILE=${projects}/FirstGame/build/FirstGame.sln" -DSTARTUP_PROJECT=FirstGameEditor
    -DMODULE_TARGET=FirstGame "-DSDK_ROOT=${sdk}" "-DPROJECT_FILE=${projects}/FirstGame/FirstGame.tinyproject"
    -P "${CMAKE_CURRENT_LIST_DIR}/ProjectVisualStudioStartupTests.cmake")
run("${CMAKE_COMMAND}" --build "${projects}/FirstGame/build" --config "${CONFIG}" --target FirstGameEditor FirstGameGame --parallel 4)
run("${RUNTIME_EXE}" --external-project "${projects}/FirstGame/FirstGame.tinyproject")
run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${CONFIG}" --component EditorRuntime --prefix "${sdk}")
file(COPY "${EDITOR_TEST_EXE}" DESTINATION "${sdk}/bin/${CONFIG}")
get_filename_component(editor_test_name "${EDITOR_TEST_EXE}" NAME)
run("${sdk}/bin/${CONFIG}/${editor_test_name}" --project-create)
run("${sdk}/bin/${CONFIG}/tinyengine_editor.exe" --frames=3)
run("${sdk}/bin/${CONFIG}/tinyengine_editor.exe" "${projects}/FirstGame/FirstGame.tinyproject" --frames=3)
file(WRITE "${ENGINE_BUILD}/project-creation-qa.txt" "${qa}")
