cmake_minimum_required(VERSION 3.21)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyEngineIdentityQA-${suffix}" qa)
set(source "${qa}/source")
set(build "${qa}/build")
file(MAKE_DIRECTORY "${source}/include/tinyengine" "${source}/src" "${source}/tests")
file(COPY "${ENGINE_SOURCE}/include/tinyengine/project_sdk" DESTINATION "${source}/include/tinyengine")
file(COPY "${ENGINE_SOURCE}/src/project_sdk" DESTINATION "${source}/src")
file(COPY "${ENGINE_SOURCE}/cmake" DESTINATION "${source}")
file(COPY "${ENGINE_SOURCE}/tests/project_sdk_consumer" DESTINATION "${source}/tests")
file(WRITE "${source}/revision.txt" "first")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(IdentityQA VERSION 0.27.0 LANGUAGES C CXX)
execute_process(COMMAND git rev-parse --short=12 HEAD WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE TINYENGINE_GIT_REVISION OUTPUT_STRIP_TRAILING_WHITESPACE)
set(TINYENGINE_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}")
include(cmake/ProjectSDK.cmake)
]=])
run(git -C "${source}" init -q)
run(git -C "${source}" add .)
run(git -C "${source}" -c user.name=TinyEngineQA -c user.email=qa@example.invalid -c commit.gpgsign=false -c gc.auto=0 commit -qm first)
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G "${GENERATOR}" -A x64)
run("${CMAKE_COMMAND}" --build "${build}" --config Debug --target tinyengine_project_sdk --parallel 4)
set(info "${build}/generated/sdk/include/tinyengine/project_sdk/build_info_debug.h")
file(READ "${info}" before)
if(MODE STREQUAL "git")
    file(WRITE "${source}/revision.txt" "second")
    run(git -C "${source}" add revision.txt)
    run(git -C "${source}" -c user.name=TinyEngineQA -c user.email=qa@example.invalid -c commit.gpgsign=false -c gc.auto=0 commit -qm second)
else()
    file(APPEND "${source}/src/project_sdk/project.cpp" "\n// identity must change for this uncommitted source revision\n")
endif()
run("${CMAKE_COMMAND}" --build "${build}" --config Debug --target tinyengine_project_sdk --parallel 4)
file(READ "${info}" after)
if(before STREQUAL after)
    message(FATAL_ERROR "Incremental SDK build retained stale ${MODE} identity: ${qa}")
endif()
message(STATUS "PASS incremental SDK ${MODE} identity changes without manual reconfigure")
