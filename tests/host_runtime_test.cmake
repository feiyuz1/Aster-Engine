cmake_minimum_required(VERSION 3.21)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${out}\n${err}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyEngineHostRuntimeQA-${suffix}" qa)
file(MAKE_DIRECTORY "${qa}/source")
file(WRITE "${qa}/source/Host.cpp" "#include <iostream>\nextern \"C\" __declspec(dllimport) int tinyDependencyValue();\nint main(){std::cout<<tinyDependencyValue();return tinyDependencyValue()==42?0:1;}\n")
file(WRITE "${qa}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.21)\nproject(RuntimeQA LANGUAGES CXX)\ninclude(GNUInstallDirs)\nadd_library(SDL2 SHARED [==[${ENGINE_SOURCE}/tests/test_runtime_dependency.cpp]==])\nadd_library(SDL2::SDL2 ALIAS SDL2)\nadd_executable(host Host.cpp)\ntarget_link_libraries(host PRIVATE SDL2::SDL2)\ninclude([==[${ENGINE_SOURCE}/cmake/InstallHostRuntime.cmake]==])\ntinyengine_install_host_runtime(host ProjectRuntime)\ntinyengine_install_host_runtime(host EditorRuntime)\n")
run("${CMAKE_COMMAND}" -S "${qa}/source" -B "${qa}/build" -G "${GENERATOR}" -A x64)
run("${CMAKE_COMMAND}" --build "${qa}/build" --config Debug --parallel 4)
foreach(component ProjectRuntime EditorRuntime)
    set(prefix "${qa}/${component}")
    run("${CMAKE_COMMAND}" --install "${qa}/build" --config Debug --component "${component}" --prefix "${prefix}")
    if(NOT EXISTS "${prefix}/bin/Debug/SDL2.dll")
        message(FATAL_ERROR "Installed ${component} omits the shared SDL runtime")
    endif()
    if(NOT EXISTS "${prefix}/bin/Debug/host.pdb")
        message(FATAL_ERROR "Installed ${component} omits the host debugging symbols")
    endif()
    file(SHA256 "${qa}/build/Debug/host.pdb" built_symbols)
    file(SHA256 "${prefix}/bin/Debug/host.pdb" installed_symbols)
    if(NOT built_symbols STREQUAL installed_symbols)
        message(FATAL_ERROR "Installed ${component} debugging symbols do not match the built host")
    endif()
    execute_process(COMMAND "${prefix}/bin/Debug/host.exe" WORKING_DIRECTORY "${qa}" RESULT_VARIABLE result OUTPUT_VARIABLE out)
    if(NOT result EQUAL 0 OR NOT out STREQUAL "42")
        message(FATAL_ERROR "Installed ${component} cannot execute its DLL dependency: ${result}, ${out}")
    endif()
endforeach()
message(STATUS "PASS installed game/editor runtime dependencies and matching debugging symbols")
