cmake_minimum_required(VERSION 3.21)
if(NOT EXISTS "${TOOL}")
    message(FATAL_ERROR "ProjectTool executable does not exist: ${TOOL}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyProjectTool-${suffix} 中文 path" qa)
file(MAKE_DIRECTORY "${qa}/Game 中文")
set(game "${qa}/Game 中文")
file(WRITE "${game}/Game.tinyproject" "project.name=Game\n")
file(WRITE "${game}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.21)\nproject(ToolSmoke LANGUAGES NONE)\nfind_package(TinyEngine CONFIG REQUIRED)\nfile(WRITE \"\${CMAKE_BINARY_DIR}/selected-sdk.txt\" \"\${SELECTED_SDK}\")\n")
foreach(id A B)
    set(sdk "${qa}/SDK ${id}")
    file(MAKE_DIRECTORY "${sdk}/lib/cmake/TinyEngine" "${sdk}/Programs/ProjectTool")
    file(WRITE "${sdk}/lib/cmake/TinyEngine/TinyEngineConfig.cmake" "set(SELECTED_SDK ${id})\n")
    file(COPY "${TOOL}" DESTINATION "${sdk}/Programs/ProjectTool")
    get_filename_component(name "${TOOL}" NAME)
    execute_process(COMMAND "${sdk}/Programs/ProjectTool/${name}" --generate-project "${game}/Game.tinyproject" --quiet
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Generate with SDK ${id} failed: ${result}\n${output}\n${errors}")
    endif()
    file(READ "${game}/build/selected-sdk.txt" selected)
    if(NOT selected STREQUAL id)
        message(FATAL_ERROR "Stale SDK binding: expected ${id}, got ${selected}")
    endif()
endforeach()
if(NOT EXISTS "${game}/build/ToolSmoke.sln" OR NOT EXISTS "${game}/Saved/ProjectTool/GenerateSolution.log")
    message(FATAL_ERROR "Missing solution or diagnostic log")
endif()
execute_process(COMMAND "${TOOL}" --generate-project "${game}/absent.tinyproject" --quiet RESULT_VARIABLE missing)
if(missing EQUAL 0)
    message(FATAL_ERROR "Missing project was accepted")
endif()
execute_process(COMMAND "${TOOL}" --generate-project "${game}/Game.tinyproject" --sdk-root "${qa}/SDK B"
    --cmake "${qa}/missing-cmake.exe" --quiet RESULT_VARIABLE bad_cmake)
if(bad_cmake EQUAL 0)
    message(FATAL_ERROR "Missing CMake was accepted")
endif()
file(READ "${game}/Saved/ProjectTool/GenerateSolution.log" diagnostic)
if(diagnostic STREQUAL "")
    message(FATAL_ERROR "Failure diagnostic is empty")
endif()
message(STATUS "ProjectTool generates Unicode paths, rebinds SDK cache, and reports invalid inputs")
