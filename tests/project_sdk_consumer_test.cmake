cmake_minimum_required(VERSION 3.21)
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${errors}")
    endif()
endfunction()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
file(TO_CMAKE_PATH "$ENV{TEMP}/TinyEngineSDKQA-${suffix}" qa)
set(sdk_original "${qa}/sdk-original")
set(sdk "${qa}/SDK 中文 with spaces")
set(consumer "${qa}/Consumer")
if(RUNTIME)
    set(consumer "${qa}/项目 Consumer")
    # This test exercises both profiles. A fresh Debug-only checkout must not
    # depend on leftover Release executables from an earlier manual build.
    foreach(config Debug Release)
        run("${CMAKE_COMMAND}" --build "${ENGINE_BUILD}" --config "${config}"
            --target tinyengine_game tinyengine_project_module_tests --parallel 4)
    endforeach()
    run("${CMAKE_COMMAND}" --build "${ENGINE_BUILD}" --config Debug --target tinyengine_editor --parallel 4)
endif()
file(MAKE_DIRECTORY "${consumer}")
foreach(config Debug Release)
    run("${CMAKE_COMMAND}" --build "${ENGINE_BUILD}" --config "${config}" --target tinyengine_project_sdk --parallel 4)
    run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${config}" --component ProjectSDK --prefix "${sdk_original}")
endforeach()
file(RENAME "${sdk_original}" "${sdk}")
file(COPY "${sdk}/share/tinyengine/templates/ProjectModule/" DESTINATION "${consumer}")
file(WRITE "${consumer}/Game.tinyproject" "project.name=RotateGame\nproject.id=sdk-consumer\ncode.module=game.rotate\ncode.required=true\ncode.manifest=Binaries/Windows-x64/Project.modules\nproject.startupScene=Start.scene\n")
run("${CMAKE_COMMAND}" -S "${consumer}" -B "${consumer}/build" -G "${GENERATOR}" -A x64
    "-DCMAKE_PREFIX_PATH=${sdk}" "-DEXPECTED_SDK_PREFIX=${sdk}")
if(GENERATOR MATCHES "^Visual Studio")
    run("${CMAKE_COMMAND}" "-DSOLUTION_FILE=${consumer}/build/TinySDKConsumer.sln" -DSTARTUP_PROJECT=RotateGameGame
        -DMODULE_TARGET=RotateGame "-DSDK_ROOT=${sdk}" "-DPROJECT_FILE=${consumer}/Game.tinyproject"
        -P "${CMAKE_CURRENT_LIST_DIR}/project_visual_studio_startup_test.cmake")
    # A project-only SDK must diagnose the missing editor instead of launching
    # a nonexistent executable. Building this entry also builds the DLL first.
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug --target RotateGameEditor
        RESULT_VARIABLE missing_editor OUTPUT_VARIABLE missing_output ERROR_VARIABLE missing_errors)
    if(missing_editor EQUAL 0 OR NOT "${missing_output}\n${missing_errors}" MATCHES "Missing Debug debugging host")
        message(FATAL_ERROR "Missing editor host was not diagnosed: ${missing_output}\n${missing_errors}")
    endif()
endif()
foreach(config Debug Release)
    run("${CMAKE_COMMAND}" --build "${consumer}/build" --config "${config}" --parallel 4)
endforeach()
set(manifest "${consumer}/Binaries/Windows-x64/Project.modules")
file(READ "${manifest}" before)
string(REGEX MATCH "Development.library=([^\n]+)" match "${before}")
set(previous_library "${consumer}/${CMAKE_MATCH_1}")
file(SHA256 "${previous_library}" old_hash)
if(NOT before MATCHES "Development.sdkBuildId=[a-f0-9]+" OR NOT before MATCHES "Shipping.sdkBuildId=[a-f0-9]+")
    message(FATAL_ERROR "Manifest must preserve both configuration identities: ${before}")
endif()
file(READ "${consumer}/source/game.cpp" source)
file(APPEND "${consumer}/source/game.cpp" "\n#error deliberate_compile_failure\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug RESULT_VARIABLE broken OUTPUT_QUIET ERROR_QUIET)
if(broken EQUAL 0)
    message(FATAL_ERROR "Deliberately broken project unexpectedly compiled")
endif()
file(READ "${manifest}" after_failure)
file(SHA256 "${previous_library}" after_hash)
if(NOT before STREQUAL after_failure OR NOT old_hash STREQUAL after_hash)
    message(FATAL_ERROR "Failed build replaced the last working manifest or binary")
endif()
file(WRITE "${consumer}/source/game.cpp" "${source}\n// second valid revision\n")
run("${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug --parallel 4)
file(READ "${manifest}" after_success)
if(before STREQUAL after_success)
    message(FATAL_ERROR "Source content change did not produce a new BuildId")
endif()
string(REGEX MATCH "Shipping.buildId=([^\n]+)" shipping "${before}")
if(NOT after_success MATCHES "${shipping}")
    message(FATAL_ERROR "Debug publishing lost the Shipping record")
endif()
# SDK identity includes the build configuration. Inspect a Development module with
# the Debug inspector even when this integration test itself was started by Release CTest.
set(development_inspector "${MODULE_TEST_EXE}")
if(GENERATOR MATCHES "Visual Studio|Xcode")
    get_filename_component(inspector_name "${MODULE_TEST_EXE}" NAME)
    set(development_inspector "${ENGINE_BUILD}/Debug/${inspector_name}")
    run("${CMAKE_COMMAND}" --build "${ENGINE_BUILD}" --config Debug
        --target tinyengine_project_module_tests --parallel 4)
endif()
run("${development_inspector}" --inspect-project "${consumer}/Game.tinyproject" Development)
if(REVIEW_VARIANT)
    file(WRITE "${consumer}/Source/BuildValue.hpp" "constexpr int ReviewValue=90;\n")
    file(APPEND "${consumer}/source/game.cpp" "\n#include \"BuildValue.hpp\"\nextern \"C\" TINY_PROJECT_EXPORT int TinyTest_ReviewValue(){return ReviewValue+REVIEW_OFFSET;}\n")
    file(APPEND "${consumer}/CMakeLists.txt" "\nset(REVIEW_OFFSET 0 CACHE STRING \"QA build setting\")\ntarget_compile_definitions(RotateGame PRIVATE REVIEW_OFFSET=\${REVIEW_OFFSET})\n")
    run("${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug --parallel 4)
    file(READ "${manifest}" before_change)
    if(REVIEW_VARIANT STREQUAL "header")
        file(WRITE "${consumer}/Source/BuildValue.hpp" "constexpr int ReviewValue=180;\n")
        set(expected 180)
    else()
        run("${CMAKE_COMMAND}" -S "${consumer}" -B "${consumer}/build" -DREVIEW_OFFSET=100)
        set(expected 190)
    endif()
    run("${CMAKE_COMMAND}" --build "${consumer}/build" --config Debug --clean-first --parallel 4)
    file(READ "${manifest}" after_change)
    string(REGEX MATCH "Development.library=([^\n]+)" match "${after_change}")
    execute_process(COMMAND "${MODULE_TEST_EXE}" --probe-value "${consumer}/${CMAKE_MATCH_1}" RESULT_VARIABLE value_exit OUTPUT_VARIABLE value_output)
    if(NOT value_exit EQUAL 0 OR NOT value_output MATCHES "REVIEW_VALUE=${expected}")
        message(FATAL_ERROR "Successful ${REVIEW_VARIANT} rebuild published stale code: ${value_output}")
    endif()
    if(before_change STREQUAL after_change)
        message(FATAL_ERROR "${REVIEW_VARIANT} edit did not update the published fingerprint")
    endif()
endif()
if(RUNTIME)
    run("${RUNTIME_TEST_EXE}" --write-scene "${consumer}/Start.scene")
    foreach(config Debug Release)
        run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config "${config}" --component ProjectRuntime --prefix "${sdk}")
        file(REMOVE "${consumer}/Logs/TinyEngine.jsonl")
        set(run_log "")
        execute_process(COMMAND "${sdk}/bin/${config}/tinyengine_game.exe" "${consumer}/Game.tinyproject" --frames=3
            WORKING_DIRECTORY "${qa}" RESULT_VARIABLE run_exit OUTPUT_VARIABLE run_output ERROR_VARIABLE run_error)
        if(EXISTS "${consumer}/Logs/TinyEngine.jsonl")
            file(READ "${consumer}/Logs/TinyEngine.jsonl" run_log)
        endif()
        set(evidence "${run_output}\n${run_error}\n${run_log}")
        file(WRITE "${qa}/runtime-${config}.log" "${evidence}")
        if(NOT run_exit EQUAL 0 OR NOT evidence MATCHES "P0_PROJECT_BEGIN" OR NOT evidence MATCHES "P0_PROJECT_ROTATED" OR NOT evidence MATCHES "P0_PROJECT_END")
            message(FATAL_ERROR "Installed ${config} runtime did not execute project code (${run_exit}): ${evidence}")
        endif()
    endforeach()
    run("${RELEASE_MODULE_TEST_EXE}" --inspect-project "${consumer}/Game.tinyproject" Shipping)
    run("${RUNTIME_TEST_EXE}" --external-project "${consumer}/Game.tinyproject")
    run("${CMAKE_COMMAND}" --install "${ENGINE_BUILD}" --config Debug --component EditorRuntime --prefix "${sdk}")
    run("${sdk}/bin/Debug/tinyengine_editor.exe" "${consumer}/Game.tinyproject" --frames=3)
endif()
file(WRITE "${QA_POINTER}" "${qa}")
message(STATUS "PASS relocated SDK Debug/Release, failed-build preservation and actual project execution: ${qa}")
