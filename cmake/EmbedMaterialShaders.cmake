# Shader includes are expanded for the legacy program; graph templates retain
# their include records so the runtime compiler tracks the same dependencies.
function(tinyengine_expand_shader input_path output_variable include_stack)
    get_filename_component(shader_path "${input_path}" ABSOLUTE)
    if(shader_path IN_LIST include_stack)
        message(FATAL_ERROR "Cyclic builtin shader include: ${shader_path}")
    endif()
    list(APPEND include_stack "${shader_path}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shader_path}")
    file(READ "${shader_path}" shader_source)
    string(REGEX MATCHALL "#include[ \t]+\"[^\"]+\"" shader_includes "${shader_source}")
    get_filename_component(shader_directory "${shader_path}" DIRECTORY)
    foreach(shader_include IN LISTS shader_includes)
        string(REGEX REPLACE "^#include[ \t]+\"([^\"]+)\"$" "\\1" shader_child "${shader_include}")
        tinyengine_expand_shader("${shader_directory}/${shader_child}" shader_expanded "${include_stack}")
        string(REPLACE "${shader_include}" "${shader_expanded}" shader_source "${shader_source}")
    endforeach()
    set(${output_variable} "${shader_source}" PARENT_SCOPE)
endfunction()

function(tinyengine_embed_material_shaders source_directory output_path)
    set(shader_header "#pragma once\nnamespace MiniEngine::BuiltinMaterialShaders {\n")
    file(GLOB_RECURSE shader_names CONFIGURE_DEPENDS RELATIVE "${source_directory}" "${source_directory}/*.glsl" "${source_directory}/*.vert" "${source_directory}/*.frag")
    set(shader_entries "")
    set(shader_index 0)
    foreach(shader_name IN LISTS shader_names)
        set(shader_path "${source_directory}/${shader_name}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shader_path}")
        file(READ "${shader_path}" shader_source)
        set(shader_identifier "shader_${shader_index}")
        math(EXPR shader_index "${shader_index} + 1")
        string(APPEND shader_header "inline constexpr const char *${shader_identifier} = R\"TINY_MATERIAL(${shader_source})TINY_MATERIAL\";\n")
        string(APPEND shader_entries "{\"${shader_name}\", ${shader_identifier}},\n")
    endforeach()
    string(APPEND shader_header "struct SourceFile { const char *name; const char *text; };\ninline constexpr SourceFile Files[] = {\n${shader_entries}};\n")
    string(APPEND shader_header "}\n")
    file(WRITE "${output_path}" "${shader_header}")
endfunction()
