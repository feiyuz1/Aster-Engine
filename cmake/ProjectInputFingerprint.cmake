include_guard(GLOBAL)

function(tinyengine_project_fingerprint target root explicit_inputs output)
    if(root STREQUAL CMAKE_BINARY_DIR)
        message(FATAL_ERROR "Project modules require a separate build directory")
    endif()
    # Include implicit local headers and nested CMake inputs, while excluding all
    # known CMake build trees and runtime/generated project directories.
    file(GLOB_RECURSE discovered CONFIGURE_DEPENDS
        "${root}/*.h" "${root}/*.hpp" "${root}/*.hxx" "${root}/*.inl" "${root}/*.inc"
        "${root}/*.c" "${root}/*.cpp" "${root}/*.cxx" "${root}/*.cmake"
        "${root}/CMakeLists.txt" "${root}/*.tinyproject")
    file(GLOB_RECURSE caches "${root}/CMakeCache.txt")
    set(build_directories "${CMAKE_BINARY_DIR}")
    foreach(cache IN LISTS caches)
        get_filename_component(directory "${cache}" DIRECTORY)
        list(APPEND build_directories "${directory}")
    endforeach()
    set(inputs ${explicit_inputs})
    foreach(path IN LISTS discovered)
        file(RELATIVE_PATH relative "${root}" "${path}")
        if(relative MATCHES "^(Binaries|Library|Logs|Saved|artifacts|\\.git|\\.superpowers)/")
            continue()
        endif()
        set(generated FALSE)
        foreach(directory IN LISTS build_directories)
            cmake_path(IS_PREFIX directory "${path}" NORMALIZE inside)
            if(inside)
                set(generated TRUE)
                break()
            endif()
        endforeach()
        if(NOT generated)
            list(APPEND inputs "${path}")
        endif()
    endforeach()
    set(paths)
    foreach(input IN LISTS inputs)
        file(REAL_PATH "${input}" path)
        file(RELATIVE_PATH relative "${root}" "${path}")
        if(relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${relative}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            message(FATAL_ERROR "Module input must be an existing project file: ${input}")
        endif()
        list(APPEND paths "${relative}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endforeach()
    list(REMOVE_DUPLICATES paths)
    list(SORT paths)
    set(content "")
    foreach(path IN LISTS paths)
        file(SHA256 "${root}/${path}" hash)
        string(APPEND content "file:${path}:${hash}\n")
    endforeach()
    # Run at the end of the declaring directory, after callers have applied
    # target settings; retain user cache values that feed build expressions.
    get_cmake_property(variables CACHE_VARIABLES)
    list(SORT variables)
    foreach(variable IN LISTS variables)
        get_property(type CACHE "${variable}" PROPERTY TYPE)
        if(NOT type STREQUAL "INTERNAL" AND NOT type STREQUAL "STATIC")
            string(APPEND content "cache:${variable}=${${variable}}\n")
        endif()
    endforeach()
    get_target_property(source_directory ${target} SOURCE_DIR)
    foreach(property COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FEATURES INCLUDE_DIRECTORIES
                     LINK_OPTIONS LINK_DIRECTORIES LINK_LIBRARIES CXX_STANDARD MSVC_RUNTIME_LIBRARY
                     INTERPROCEDURAL_OPTIMIZATION INTERPROCEDURAL_OPTIMIZATION_DEBUG INTERPROCEDURAL_OPTIMIZATION_RELEASE)
        get_target_property(value ${target} ${property})
        if(NOT value MATCHES "-NOTFOUND$")
            string(APPEND content "target:${property}=${value}\n")
        endif()
        get_directory_property(value DIRECTORY "${source_directory}" ${property})
        string(APPEND content "directory:${property}=${value}\n")
    endforeach()
    # A project/SDK relocation does not itself change the source identity.
    if(TinyEngine_DIR)
        get_filename_component(sdk_root "${TinyEngine_DIR}/../../.." ABSOLUTE)
        string(REPLACE "${sdk_root}" "<SDK>" content "${content}")
    endif()
    string(REPLACE "${CMAKE_BINARY_DIR}" "<BUILD>" content "${content}")
    string(REPLACE "${root}" "<PROJECT>" content "${content}")
    string(SHA256 fingerprint "${content}")
    set(${output} "${fingerprint}" PARENT_SCOPE)
endfunction()
