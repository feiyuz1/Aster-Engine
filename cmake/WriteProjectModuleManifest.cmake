cmake_minimum_required(VERSION 3.21)
if(NOT sdk OR NOT profile MATCHES "^(Development|Shipping)$" OR NOT EXISTS "${library}")
    message(FATAL_ERROR "Missing matching SDK, supported profile, or linked project library")
endif()
set(output "${root}/Binaries/Windows-x64")
file(MAKE_DIRECTORY "${output}")
file(LOCK "${output}/.publish.lock" GUARD PROCESS TIMEOUT 30)
set(relative "Binaries/Windows-x64/${profile}/${build}")
set(destination "${root}/${relative}")
get_filename_component(library_name "${library}" NAME)
set(pdb_relative "")
set(files "${library}")
if(EXISTS "${pdb}")
    list(APPEND files "${pdb}")
    get_filename_component(pdb_name "${pdb}" NAME)
    set(pdb_relative "${relative}/${pdb_name}")
endif()
list(APPEND files ${dependencies})
set(names)
foreach(path IN LISTS files)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Missing explicit module dependency: ${path}")
    endif()
    get_filename_component(name "${path}" NAME)
    string(TOLOWER "${name}" lower)
    if(lower IN_LIST names)
        message(FATAL_ERROR "Duplicate project artifact filename: ${name}")
    endif()
    list(APPEND names "${lower}")
endforeach()
# Published BuildId directories remain immutable. A same-input rebuild keeps the
# prior artifact; a changed input publishes to a different directory.
if(NOT EXISTS "${destination}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
    set(staging "${destination}.staging-${suffix}")
    file(MAKE_DIRECTORY "${staging}")
    foreach(path IN LISTS files)
        file(COPY "${path}" DESTINATION "${staging}")
    endforeach()
    file(RENAME "${staging}" "${destination}")
endif()
foreach(path IN LISTS files)
    get_filename_component(name "${path}" NAME)
    if(NOT EXISTS "${destination}/${name}")
        message(FATAL_ERROR "Incomplete previously published BuildId: ${destination}")
    endif()
endforeach()
set(manifest "${output}/Project.modules")
set(preserved "")
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" lines ENCODING UTF-8)
    foreach(line IN LISTS lines)
        if(line MATCHES "^(Development|Shipping)\\." AND NOT line MATCHES "^${profile}\\.")
            string(APPEND preserved "${line}\n")
        endif()
    endforeach()
endif()
set(text "module.id=${module}\nproject.id=${project}\nmodule.abi=1\nmodule.platform=Windows-x64\n${preserved}")
string(APPEND text "${profile}.sdkBuildId=${sdk}\n${profile}.library=${relative}/${library_name}\n${profile}.pdb=${pdb_relative}\n${profile}.buildId=${build}\n${profile}.sourceFingerprint=${fingerprint}\n${profile}.schemaHash=none\n")
list(LENGTH dependencies count)
string(APPEND text "${profile}.dependencies.count=${count}\n")
set(index 0)
foreach(path IN LISTS dependencies)
    get_filename_component(name "${path}" NAME)
    string(APPEND text "${profile}.dependencies.${index}=${relative}/${name}\n")
    math(EXPR index "${index}+1")
endforeach()
file(WRITE "${manifest}.tmp" "${text}")
file(RENAME "${manifest}.tmp" "${manifest}")
