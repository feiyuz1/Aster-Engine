# 默认不纳入 Git，只开放需要提交的项目内容。
/*

# 仓库配置与构建入口
!/.gitignore
!/.gitattributes
!/.clang-format
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/windows.yml
!/CMakeLists.txt
!/Doxyfile
!/README.md
!/TinyEngine.tinyproject
!/设计.md
!/第三方依赖与许可.md

# 引擎、编辑器与工具源码
!/cmake/
!/editor/
!/include/
!/src/
!/tools/

# 相机移动与渲染稳定性的回归测试。
!/tests/
/tests/*
!/tests/RenderStabilityTests.cpp

# 技术说明文档
!/docs/
/docs/*
!/docs/使用指南.md
!/docs/原生插件API.md
!/docs/工具参考.md
!/docs/文档中心.md
!/docs/构建指南.md
!/docs/源码阅读与注释规范.md
!/docs/联网指南.md
!/docs/资产与数据格式.md
!/docs/项目架构.md
!/docs/项目工作流.md

# 引擎基础素材
!/assets/
/assets/*
!/assets/Demo.scene
!/assets/Demo.scene.meta
!/assets/default.input
!/assets/default.input.meta
!/assets/default.mat
!/assets/default.mat.meta
!/assets/default.ppm
!/assets/default.ppm.meta
!/assets/player.anim
!/assets/player.anim.meta
!/assets/player.mesh
!/assets/player.mesh.meta
!/assets/shaders/
/assets/shaders/*
!/assets/shaders/default.frag
!/assets/shaders/default.frag.meta
!/assets/shaders/default.vert
!/assets/shaders/default.vert.meta
