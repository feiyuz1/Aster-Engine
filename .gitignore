# 默认不纳入 Git，只开放需要提交的项目内容。
/*

# 仓库配置与构建入口
!/.gitignore
!/.gitattributes
!/.clang-format
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/windows.yml
!/CMakeLists.txt
!/CMakePresets.json
!/Doxyfile
!/README.md
!/TinyEngine.tinyproject

# 引擎、编辑器与工具源码
!/cmake/
!/editor/
!/include/
!/src/
!/tools/

# 相机移动与渲染稳定性的回归测试。
!/tests/
/tests/*
!/tests/RenderStabilityTests.cpp
!/tests/MaterialSystemTests.cpp
!/tests/MaterialRenderTests.cpp
!/tests/EngineTests.cpp

# 文档只跟踪使用指南和参考资料，其余保留在本地。
!/docs/
/docs/*
!/docs/Guides/
!/docs/Reference/

# 引擎基础素材
!/assets/
/assets/*
!/assets/Demo.scene
!/assets/Demo.scene.meta
!/assets/default.input
!/assets/default.input.meta
!/assets/default.mat
!/assets/default.mat.meta
!/assets/default.ppm
!/assets/default.ppm.meta
!/assets/player.anim
!/assets/player.anim.meta
!/assets/player.mesh
!/assets/player.mesh.meta
!/assets/shaders/
/assets/shaders/*
!/assets/shaders/default.frag
!/assets/shaders/default.frag.meta
!/assets/shaders/default.vert
!/assets/shaders/default.vert.meta
!/assets/shaders/material/
/assets/shaders/material/*
!/assets/shaders/material/Surface.glsl
!/assets/shaders/material/Lighting.glsl
!/assets/shaders/material/VertexTransform.glsl
!/assets/shaders/material/BasePass.vert
!/assets/shaders/material/BasePass.frag
!/assets/shaders/material/ShadowPass.vert
!/assets/shaders/material/ShadowPass.frag
!/tests/EditorInteractionTests.cpp
!/tests/ExtendedRegressionTests.cpp
!/assets/Materials/
/assets/Materials/*
!/assets/Materials/M_Paint.matgraph
!/assets/Materials/MI_PaintRed.mat
!/assets/Materials/MI_PaintBlue.mat
!/assets/Materials/M_Masked.matgraph
!/assets/Materials/MI_Masked.mat
!/assets/Materials/T_Mask.ppm

!/tests/EditorAssetRenameTests.cpp
!/tests/MaterialEditorTests.cpp
!/tests/AssetTrashTests.cpp
!/tests/ProjectSDKAbiC.c
!/tests/ProjectSDKAbiTests.cpp
!/tests/ProjectModuleTests.cpp
!/tests/ProjectRuntimeTests.cpp
!/tests/ProjectSDKConsumer/
!/tests/ProjectSDKConsumerTests.cmake
!/tests/TestProjectModule.cpp
!/tests/TestProjectMissingEntry.cpp
!/tests/TestDynamicPlugin.cpp
!/tests/TestRuntimeDependency.cpp
!/tests/TestDependentPlugin.cpp
!/tests/ProjectSDKIdentityTests.cmake
!/tests/HostRuntimeTests.cmake
!/tests/ProjectCreationTests.cpp
!/tests/ProjectCreationTests.cmake
!/tests/ProjectToolDiscoveryTests.cpp
!/Programs/
!/tests/ProjectToolTests.cmake
!/tests/ProjectShellMenuTests.cpp

# Repository maintenance scripts
!/Scripts/
!/tests/SceneSaveTests.cpp
!/tests/PlatformMountTests.cpp
!/tests/ScriptLifecycleTests.cpp
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/EditorUI/
/tests/fixtures/EditorUI/*
!/tests/fixtures/EditorUI/assets/
/tests/fixtures/EditorUI/assets/*
!/tests/fixtures/EditorUI/assets/audio/
/tests/fixtures/EditorUI/assets/audio/*
!/tests/fixtures/EditorUI/assets/audio/long_stream.ogg
