# 默认不纳入 Git，只开放需要提交的项目内容。
/*

# 仓库配置与构建入口
!/.gitignore
!/.gitattributes
!/.clang-format
!/.clang-tidy
!/.editorconfig
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/windows.yml
!/CMakeLists.txt
!/CMakePresets.json
!/Doxyfile
!/README.md
!/Aster-Engine.tinyproject

# 引擎、编辑器与工具源码
!/cmake/
!/editor/
!/include/
!/src/
!/tools/

# 相机移动与渲染稳定性的回归测试。
!/tests/
/tests/*
!/tests/render_stability_test.cpp
!/tests/material_system_test.cpp
!/tests/material_render_test.cpp
!/tests/engine_test.cpp
# Project SDK 玩法扩展（aster.gameplay）的宿主契约测试，由 CMakeLists 引用，必须入库。
!/tests/project_gameplay_test.cpp

# 文档只跟踪使用指南和参考资料，其余保留在本地。
!/docs/
/docs/*
!/docs/guides/
!/docs/reference/

# 引擎基础素材
!/assets/
/assets/*
!/assets/Demo.scene
!/assets/Demo.scene.meta
!/assets/default.input
!/assets/default.input.meta
!/assets/default.mat
!/assets/default.mat.meta
!/assets/default.ppm
!/assets/default.ppm.meta
!/assets/player.anim
!/assets/player.anim.meta
!/assets/player.mesh
!/assets/player.mesh.meta
!/assets/shaders/
/assets/shaders/*
!/assets/shaders/default.frag
!/assets/shaders/default.frag.meta
!/assets/shaders/default.vert
!/assets/shaders/default.vert.meta
!/assets/shaders/material/
/assets/shaders/material/*
!/assets/shaders/material/Surface.glsl
!/assets/shaders/material/Lighting.glsl
!/assets/shaders/material/VertexTransform.glsl
!/assets/shaders/material/BasePass.vert
!/assets/shaders/material/BasePass.frag
!/assets/shaders/material/ShadowPass.vert
!/assets/shaders/material/ShadowPass.frag
!/tests/editor_interaction_test.cpp
!/tests/extended_regression_test.cpp
!/assets/Materials/
/assets/Materials/*
!/assets/Materials/M_Paint.matgraph
!/assets/Materials/MI_PaintRed.mat
!/assets/Materials/MI_PaintBlue.mat
!/assets/Materials/M_Masked.matgraph
!/assets/Materials/MI_Masked.mat
!/assets/Materials/T_Mask.ppm

!/tests/editor_asset_rename_test.cpp
!/tests/material_editor_test.cpp
!/tests/asset_trash_test.cpp
!/tests/project_sdk_abi_c.c
!/tests/project_sdk_abi_test.cpp
!/tests/project_module_test.cpp
!/tests/project_runtime_test.cpp
!/tests/project_sdk_consumer/
!/tests/project_sdk_consumer_test.cmake
!/tests/test_project_module.cpp
!/tests/test_project_missing_entry.cpp
!/tests/test_dynamic_plugin.cpp
!/tests/test_runtime_dependency.cpp
!/tests/test_dependent_plugin.cpp
!/tests/project_sdk_identity_test.cmake
!/tests/host_runtime_test.cmake
!/tests/project_creation_test.cpp
!/tests/project_creation_test.cmake
!/tests/project_tool_discovery_test.cpp
!/programs/
!/tests/project_tool_test.cmake
!/tests/project_visual_studio_startup_test.cmake
!/tests/project_shell_menu_test.cpp

# Repository maintenance scripts
!/scripts/
!/tests/scene_save_test.cpp
!/tests/platform_mount_test.cpp
!/tests/script_lifecycle_test.cpp
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/editor_ui/
/tests/fixtures/editor_ui/*
!/tests/fixtures/editor_ui/assets/
/tests/fixtures/editor_ui/assets/*
!/tests/fixtures/editor_ui/assets/audio/
/tests/fixtures/editor_ui/assets/audio/*
!/tests/fixtures/editor_ui/assets/audio/long_stream.ogg
